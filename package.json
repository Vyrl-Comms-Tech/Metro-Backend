{
  "name": "metro-backend",
  "private": true,
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "seed": "node src/seed.js",
    "categories:add": "node src/addCatalogueCategories.js",
    "scrape": "node scripts/scrapeCollection.js",
    "scrape:wedding-rings": "node scripts/scrapeCollection.js wedding-rings wedding-rings",
    "import:wedding-rings": "node scripts/importWeddingRings.js",
    "scrape:earrings": "node scripts/scrapeVariantCollection.js earrings",
    "scrape:bracelets": "node scripts/scrapeVariantCollection.js bracelets",
    "scrape:necklaces": "node scripts/scrapeVariantCollection.js necklaces",
    "scrape:rings": "node scripts/scrapeVariantCollection.js rings wedding-rings --refresh && node scripts/mergeRings.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1158.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
